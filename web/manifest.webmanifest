{
  "name": "OpenMCM2",
  "short_name": "OpenMCM2",
  "description": "Motocross Madness 2, open source, in your browser. Play from your own copy of the game or with the Free Pack.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
