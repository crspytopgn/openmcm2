#!/bin/sh
# The AppImage's entry: the launcher (`--play` starts the game straight
# away with the launcher's saved settings), or `--tools` for mm2-tools.
here=$(dirname "$(readlink -f "$0")")
if [ "$1" = "--tools" ]; then
  shift
  exec "$here/usr/bin/mm2-tools" "$@"
fi
exec "$here/usr/bin/mm2-launcher" "$@"
